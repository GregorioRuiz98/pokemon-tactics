# Normalize project source; preserve imported resources and their recorded hashes.
* text=auto eol=lf
public/** -text
godot/assets/** -text
godot/assets/** whitespace=-blank-at-eol,-space-before-tab
# Raw API snapshots retain the exact bytes recorded in their manifest.
godot/data/kanto-sources/** -text
godot/licenses/** -text
tools/vendor/** -text
# Upstream license whitespace is retained verbatim.
public/licenses/** whitespace=-blank-at-eol
godot/licenses/** whitespace=-blank-at-eol
