{
  "name": "pokemon-tactics",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Prototipo local de RPG táctico Pokémon — sprint 3: POO, tipos, habilidades y estados",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:assets": "node tools/verify-assets.mjs",
    "test:browser": "node --experimental-strip-types tools/browser-sprint3.cjs",
    "test:browser:training": "node tools/browser-sprint1.cjs"
  },
  "dependencies": {
    "easystarjs": "0.4.4",
    "phaser": "4.0.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "typescript": "5.7.3",
    "vite": "6.4.4"
  }
}
