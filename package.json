{
  "name": "pokemon-tactics",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Roguelike táctico Pokémon con experiencia y evoluciones",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:assets": "node tools/verify-assets.mjs",
    "test:browser": "node --experimental-strip-types tools/browser-campaign.cjs",
    "test:browser:combat": "node --experimental-strip-types tools/browser-sprint4.cjs",
    "test:browser:lifecycle": "node --experimental-strip-types tools/browser-lifecycle.cjs",
    "test:browser:training": "node tools/browser-sprint1.cjs",
    "test:browser:release": "node --experimental-strip-types tools/browser-release.cjs",
    "test:browser:zones": "node --experimental-strip-types tools/browser-zones.cjs",
    "simulate": "node --experimental-strip-types tools/simulate-campaign.ts",
    "release:prepare": "node tools/prepare-release.mjs",
    "verify:build": "node tools/verify-build.mjs",
    "test:browser:package": "node tools/browser-package.cjs",
    "simulate:balance": "node --experimental-strip-types tools/balance/audit.ts",
    "simulate:balance:opening": "node --experimental-strip-types tools/balance/opening_probe.ts",
    "verify:balance": "node --experimental-strip-types tools/balance/verify_audit.ts"
  },
  "dependencies": {
    "easystarjs": "0.4.4",
    "phaser": "4.0.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "typescript": "5.7.3",
    "vite": "6.4.4"
  }
}
