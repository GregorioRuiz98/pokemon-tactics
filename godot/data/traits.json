  "abilities": {
    "sturdy": {
      "name": "Robustez",
      "description": "Robustez: con todos sus PS resiste un golpe que lo debilitaría, quedando en 1 PS. No evita daño residual o costes propios. Los multiimpactos actuales se resuelven como un golpe táctico agregado.",
      "available": true
    },
    "static": {
      "name": "Electricidad Estática",
      "description": "Elec. Estática: 30 % de paralizar a quien le acierte con contacto. El atacante debe seguir vivo, admitir parálisis y no tener otro estado principal.",
      "available": true
    },
    "compound-eyes": {
      "name": "Ojo Compuesto",
      "description": "Ojo Compuesto: multiplica la precisión de sus movimientos por 1,3.",
      "available": true
    },
    "shield-dust": {
      "name": "Polvo Escudo",
      "description": "Polvo Escudo: bloquea efectos secundarios de movimientos dañinos enemigos; no movimientos de estado, empujes ni sus efectos propios.",
      "available": true
    },
    "chlorophyll": {
      "name": "Clorofila",
      "description": "Clorofila: duplica la Velocidad con sol. Pendiente del sistema de clima; no tiene efecto en los escenarios actuales.",
      "available": false
    },
    "run-away": {
      "name": "Fuga",
      "description": "Fuga: garantiza la huida ante Pokémon salvajes. Pendiente de la acción de huida; no tiene efecto en los encuentros actuales.",
      "available": false
    },
    "keen-eye": {
      "name": "Vista Lince",
      "description": "Vista Lince: evita bajadas de precisión e ignora etapas positivas de evasión del objetivo.",
      "available": true
    },
    "shed-skin": {
      "name": "Mudar",
      "description": "Mudar: probabilidad de 1/3 de curar el estado principal al terminar su activación, antes del daño residual. No cura confusión ni Drenadoras.",
      "available": true
    },
    "guts": {
      "name": "Agallas",
      "description": "Agallas: Ataque ×1,5 al tener un estado principal; evita la reducción ofensiva de quemadura.",
      "available": true
    },
    "overgrow": {
      "name": "Espesura",
      "description": "Espesura: potencia de movimientos Planta ×1,5 con un tercio de PS o menos.",
      "available": true
    },
    "blaze": {
      "name": "Mar Llamas",
      "description": "Mar Llamas: potencia de movimientos Fuego ×1,5 con un tercio de PS o menos.",
      "available": true
    },
    "torrent": {
      "name": "Torrente",
      "description": "Torrente: potencia de movimientos Agua ×1,5 con un tercio de PS o menos.",
      "available": true
    },
    "swarm": {
      "name": "Enjambre",
      "description": "Enjambre: potencia de movimientos Bicho ×1,5 con un tercio de PS o menos.",
      "available": true
    },
    "rock-head": {
      "name": "Cabeza Roca",
      "description": "Cabeza Roca: evita el retroceso de movimientos. No evita Vidaesfera ni el coste de Autodestrucción.",
      "available": true
    },
    "tangled-feet": {
      "name": "Tumbos",
      "description": "Tumbos: duplica su evasión mientras está confuso.",
      "available": true
    }
  },
